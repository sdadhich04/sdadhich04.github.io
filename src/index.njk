---
layout: layouts/base.njk
permalink: /
pageClass: page-home
eleventyComputed:
  title: "{{ home.title }}"
  description: "{{ home.description }}"
---
{%- set nameParts = home.name.split(" ") -%}
<section class="hero" aria-labelledby="hero-name">
  <div class="hero__grid">
    <p class="hero__cred">{{ home.credentials | join(" · ") }}{% if home.status %} <span class="hero__status"><span class="hero__sep" aria-hidden="true">|</span> <span class="hero__open">{{ home.status }}</span></span>{% endif %}</p>
    <h1 class="hero__name" id="hero-name">{% for n in nameParts %}<span>{{ n }}</span>{% endfor %}</h1>
    <p class="hero__positioning">{{ home.positioning }}</p>
    <div class="hero__now">
      <h2 class="visually-hidden" id="now">{{ home.nowHeading }}</h2>
      <ul class="hero__roles" aria-labelledby="now">
      {%- for r in home.roles %}
        <li>{% if r.active %}<span class="hero__dot" aria-hidden="true">●</span><span class="visually-hidden">Active: </span>{% endif %}{{ r.lab }} · {{ r.area }}</li>
      {%- endfor %}
      </ul>
    </div>
    <div class="hero__actions">
    {%- for b in home.buttons %}
      <a class="btn {{ 'btn--primary' if loop.first else 'btn--secondary' }}" href="{{ b.href }}">{{ b.label }} <span aria-hidden="true">→</span></a>
    {%- endfor %}
    </div>
    <a class="hero__scroll" href="#featured">Scroll <span aria-hidden="true">↓</span></a>
    <div class="hero__art"><div class="hero__render">{% heroPicture home.hero.name, home.hero.mobile, home.hero.alt %}</div></div>
  </div>
</section>

<section class="wrap section" aria-labelledby="featured">
  <div class="section__head">
    <h2 id="featured" class="label-heading">{{ home.featuredHeading }}</h2>
    <a class="mono-link" href="/projects/">All projects →</a>
  </div>
  <ul class="cards">
  {%- for f in home.featured %}
    {% include "partials/card.njk" %}
  {%- endfor %}
  </ul>
</section>

<section class="wrap section" aria-labelledby="toolkit">
  <div class="section__head">
    <h2 id="toolkit" class="label-heading">{{ home.toolkitHeading }}</h2>
  </div>
  <p class="section__intro">{{ home.toolkitIntro }}</p>
  {% include "partials/toolkit.njk" %}
</section>

<section class="wrap section" aria-labelledby="contact">
  <div class="contact">
    <h2 id="contact">{{ home.contactHeading }}</h2>
    <dl class="contact__list">
    {%- for c in home.contact %}
      <div><dt class="label">{{ c.label }}</dt><dd><a href="{{ c.href }}">{{ c.text }}</a></dd></div>
    {%- endfor %}
    </dl>
    <p class="label">{{ home.location }}</p>
  </div>
</section>

{%- if home.approach %}
<section class="wrap section approach" aria-labelledby="approach">
  <div class="section__head"><h2 id="approach" class="label-heading">{{ home.approach.heading }}</h2></div>
  <div class="approach__grid">
    <p class="approach__head">{{ home.approach.headline }}</p>
    <div class="approach__body">
    {%- for t in home.approach.body %}
      <p>{{ t | mdInline | safe }}</p>
    {%- endfor %}
      <ol class="approach__chain" aria-label="The stages, in order">
      {%- for c in home.approach.chain %}<li>{{ c }}</li>{% endfor -%}
      </ol>
    {%- if home.approach.link %}
      <a class="mono-link" href="{{ home.approach.link.href }}">{{ home.approach.link.label }} →</a>
    {%- endif %}
    </div>
  </div>
</section>
{%- endif %}
