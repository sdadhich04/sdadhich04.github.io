{%- from "partials/icons.njk" import icon -%}
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/"><span class="brand__rule" aria-hidden="true"></span>{{ site.name | upper }}</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu">Menu</button>
    <div class="site-menu" id="site-menu">
      <nav aria-label="Primary">
        <ul class="nav">
        {%- for item in nav %}
          <li><a href="{{ item.href }}"{% if item.href != "/resume.pdf" and (item.href in page.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
        </ul>
      </nav>
      <ul class="contact-icons" aria-label="Contact">
        <li><a class="icon-link" href="mailto:{{ site.email }}" aria-label="Email {{ site.email }}">{{ icon("email") | safe }}<span class="icon-link__label" aria-hidden="true">Email</span></a></li>
        <li><a class="icon-link" href="{{ site.linkedin }}" aria-label="LinkedIn profile">{{ icon("linkedin") | safe }}<span class="icon-link__label" aria-hidden="true">LinkedIn</span></a></li>
        <li><a class="icon-link" href="{{ site.github }}" aria-label="GitHub profile">{{ icon("github") | safe }}<span class="icon-link__label" aria-hidden="true">GitHub</span></a></li>
        <li><a class="icon-link" href="{{ site.resume }}" aria-label="Résumé PDF">{{ icon("resume") | safe }}<span class="icon-link__label" aria-hidden="true">Résumé PDF</span></a></li>
      </ul>
    </div>
  </div>
</header>
