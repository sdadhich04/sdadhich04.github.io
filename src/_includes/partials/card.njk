{#- featured project card (R4): visual, title, chips, result and role, tags; the whole card is one link named by its title and described by its result line. Expects `f` from home.json -#}
<li>
  <a class="card" href="{{ f.href }}" aria-labelledby="card-{{ f.slug }}" aria-describedby="card-{{ f.slug }}-result">
    <div class="card__visual">{% cardVisual media.projects[f.slug].card %}</div>
    <h3 class="card__title" id="card-{{ f.slug }}">{{ f.title }}</h3>
    <p class="chips">{% for c in f.chips %}{{ c | chip | safe }}{% endfor %}</p>
    {%- for t in f.text %}
    <p class="card__text{% if t[0] == '*' %} card__ack{% endif %}"{% if loop.first %} id="card-{{ f.slug }}-result"{% endif %}>{{ t | mdInline | safe }}</p>
    {%- endfor %}
    <p class="tags">{{ f.tags | join(" · ") }}</p>
  </a>
</li>
